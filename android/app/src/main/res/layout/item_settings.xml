<?xml version="1.0" encoding="utf-8"?>
<!-- Same columns as item_channel so the label lines up with the channel names. ChannelAdapter switches the icon between
     the logo slot (logos on) and the number slot (logos off, where channel rows have no logo column). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/item_bg"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <Space
        android:id="@+id/settings_slot"
        android:layout_width="48dp"
        android:layout_height="1dp" />

    <ImageView
        android:id="@+id/settings_icon"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/list_icon" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/settings"
        android:textColor="#B3FFFFFF"
        android:textSize="18sp" />
</LinearLayout>
