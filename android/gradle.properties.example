org.gradle.jvmargs=-Xmx2g -Dfile.encoding=UTF-8
android.useAndroidX=true
kotlin.code.style=official
android.nonTransitiveRClass=true

# KPN account + the deviceId already registered to it (serial-based SHA-256 of the Philips TV).
# Sessions are minted from the deviceId alone, so this is the only "credential".
kpn.account=YOUR_KPN_ACCOUNT_NUMBER
kpn.deviceId=YOUR_REGISTERED_DEVICE_ID_SHA256
org.gradle.java.home=/path/to/jdk-21
